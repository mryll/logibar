{
  "schemaVersion": 1,
  "id": "mryll.logibar",
  "name": "Logibar",
  "version": "1.0.0",
  "author": "mryll",
  "license": "MIT",
  "description": "Combined battery status for Logitech Lightspeed devices (keyboard, mouse, headset) in the Omarchy bar.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "omarchy/BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Logitech Batteries",
    "description": "Click: battery panel per device. Middle click: refresh. Requires logibar-status on PATH.",
    "category": "Hardware",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "showKeyboard": true,
      "showMouse": true,
      "showHeadset": true,
      "colorMode": "full"
    },
    "schema": [
      {
        "key": "colorMode",
        "type": "enum",
        "label": "Colors",
        "description": "Monochrome rendering uses foreground tones only — severity stays readable through the numbers and glyphs. none: no color anywhere. bar-only: colored bar face, plain panel. panel-only: the reverse.",
        "options": [
          "full",
          "none",
          "bar-only",
          "panel-only"
        ],
        "defaultValue": "full"
      },
      {
        "key": "showKeyboard",
        "type": "boolean",
        "label": "Show keyboard",
        "description": "G915 X TKL battery.",
        "defaultValue": true
      },
      {
        "key": "showMouse",
        "type": "boolean",
        "label": "Show mouse",
        "description": "PRO X Superlight battery.",
        "defaultValue": true
      },
      {
        "key": "showHeadset",
        "type": "boolean",
        "label": "Show headset",
        "description": "PRO X 2 LIGHTSPEED battery.",
        "defaultValue": true
      }
    ]
  }
}
