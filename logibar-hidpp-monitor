#!/usr/bin/env python3
"""
HID++ Battery Monitor for Logitech Lightspeed devices
- Event-driven: blocking read with timeout, no polling
"""
import hid
import time
import signal
import os
import subprocess
import threading
import tempfile

VID = 0x046d
# Use XDG_RUNTIME_DIR for secure, atomic state files
STATE_DIR = os.path.join(os.environ.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}'), 'logibar')

# HID++ 1.0
RECEIVER_IDX = 0xff
REG_NOTIFICATIONS = 0x00
FLAG_WIRELESS = 0x000100
FLAG_SOFTWARE_PRESENT = 0x000800
DEVICE_NAME_FEATURE = 0x0005
BATTERY_VOLTAGE_FEATURE = 0x1001
UNIFIED_BATTERY_FEATURE = 0x1004
DEVICE_KIND = {"keyboard": 0x00, "mouse": 0x03}

# Device configurations
# (wireless_pid, wired_pid, name, waybar_signal)
DEVICES = [
    (0xc545, 0xc343, "keyboard", 9),   # G915 TKL
    (0xc547, 0xc357, "keyboard", 9),   # G915 X TKL
    (0xc547, 0xc094, "mouse", 10),     # PRO X Superlight
    (0xc54d, 0xc09b, "mouse", 10),     # PRO X Superlight 2
]
BATTERY_FEATURE_BY_RECEIVER = {
    0xc545: BATTERY_VOLTAGE_FEATURE,
}
BATTERY_VOLTAGE_LEVELS = (
    (4186, 100),
    (4067, 90),
    (3989, 80),
    (3922, 70),
    (3859, 60),
    (3811, 50),
    (3778, 40),
    (3751, 30),
    (3717, 20),
    (3671, 10),
    (3646, 5),
    (3579, 2),
    (3500, 0),
)
SHARED_RECEIVER_PIDS = {
    pid for pid, _, _, _ in DEVICES
    if sum(device_pid == pid for device_pid, _, _, _ in DEVICES) > 1
}

running = True
hid_lock = threading.Lock()
receiver_kind_lock = threading.Lock()
receiver_kinds = {}

def signal_handler(sig, frame):
    global running
    running = False

def write_state(name, battery, connected, charging, waybar_signal, state, state_lock):
    """Atomic write to state file with deduplication."""
    os.makedirs(STATE_DIR, exist_ok=True, mode=0o700)
    state_file = f"{STATE_DIR}/{name}"
    new_state = f"{battery}\n{1 if connected else 0}\n{1 if charging else 0}"

    try:
        # Check if state changed (with lock for thread safety)
        with state_lock:
            last_written = state.get('_last_written_state')
            if last_written == new_state:
                return
            state['_last_written_state'] = new_state

        # Atomic write: write to temp file, then rename
        fd, tmp_path = tempfile.mkstemp(dir=STATE_DIR)
        try:
            os.write(fd, new_state.encode())
            os.close(fd)
            os.rename(tmp_path, state_file)
        except:
            os.close(fd)
            os.unlink(tmp_path)
            raise

        subprocess.run(["pkill", f"-RTMIN+{waybar_signal}", "waybar"], stderr=subprocess.DEVNULL)
    except:
        pass

def safe_enumerate(vid, pid):
    with hid_lock:
        return [d for d in hid.enumerate(vid, pid) if d['usage_page'] == 0xff00]

def enable_notifications(dev):
    flags = FLAG_WIRELESS | FLAG_SOFTWARE_PRESENT
    cmd = [0x10, RECEIVER_IDX, 0x80, REG_NOTIFICATIONS, 0x00, (flags >> 8) & 0xff, flags & 0xff]
    try:
        dev.write(cmd)
        time.sleep(0.05)
        for _ in range(10):
            r = dev.read(64, timeout_ms=50)
            if not r:
                break
    except:
        pass

# Every other read loop in this file is already capped by a `range()`; this one
# was the exception. `while True` trusts the device to eventually go quiet, and
# a device that answers for ever — a wedged receiver, or anything plugged into
# the same VID/PID — spins this thread at 100% and it never returns to the
# event loop, so the widget freezes on its last reading. It cannot grow memory
# (every read is a fresh 64-byte buffer that is dropped) but it never ends.
# The cap converts "never returns" into "gives up and re-queries", which the
# retry/backoff in the callers already handles.
FLUSH_MAX_PACKETS = 64

def flush_buffer(dev):
    try:
        for _ in range(FLUSH_MAX_PACKETS):
            r = dev.read(64, timeout_ms=5)
            if not r:
                break
    except:
        pass

def get_feature_index(dev, device_idx, feature_id, retries=3):
    """Get a HID++ feature index with retries."""
    for attempt in range(retries):
        try:
            flush_buffer(dev)
            cmd = [0x10, device_idx, 0x00, 0x0d, feature_id >> 8, feature_id & 0xff, 0x00]
            dev.write(cmd)
            for _ in range(20):
                r = dev.read(64, timeout_ms=50)
                if r and len(r) > 4 and r[0] in [0x10, 0x11] and r[1] == device_idx and r[2] == 0x00 and r[3] == 0x0d:
                    return r[4]
        except:
            pass
        if attempt < retries - 1:
            time.sleep(0.2 * (attempt + 1))  # Backoff
    return None

def get_device_kind(path):
    """Read the paired device kind when a receiver PID is shared."""
    dev = hid.device()
    try:
        dev.open_path(path)
        enable_notifications(dev)
        feat_idx = get_feature_index(dev, 0x01, DEVICE_NAME_FEATURE)
        if feat_idx is None:
            return None

        previous_kind = None
        for _ in range(3):
            flush_buffer(dev)
            dev.write([0x11, 0x01, feat_idx, 0x20] + [0] * 16)
            for _ in range(20):
                r = dev.read(64, timeout_ms=50)
                if r and len(r) > 4 and r[0] == 0x11 and r[1] == 0x01 and r[2] == feat_idx and r[3] == 0x20:
                    kind = r[4]
                    if kind not in DEVICE_KIND.values():
                        break
                    if kind == previous_kind:
                        return kind
                    previous_kind = kind
                    break
    except:
        pass
    finally:
        try:
            dev.close()
        except:
            pass
    return None

def receiver_path_for_device(wireless_pid, name, devs):
    if wireless_pid not in SHARED_RECEIVER_PIDS:
        return devs[0]['path']
    with receiver_kind_lock:
        for path in dict.fromkeys(d['path'] for d in devs):
            kind = receiver_kinds.get(path)
            if kind is None:
                kind = get_device_kind(path)
                if kind is not None:
                    receiver_kinds[path] = kind
            if kind == DEVICE_KIND[name]:
                return path
    return None

def forget_receiver_kinds(wireless_pid):
    if wireless_pid in SHARED_RECEIVER_PIDS:
        with receiver_kind_lock:
            receiver_kinds.clear()

def voltage_to_percentage(voltage):
    if voltage >= BATTERY_VOLTAGE_LEVELS[0][0]:
        return 100
    if voltage <= BATTERY_VOLTAGE_LEVELS[-1][0]:
        return 0

    for (high_mv, high_pct), (low_mv, low_pct) in zip(BATTERY_VOLTAGE_LEVELS, BATTERY_VOLTAGE_LEVELS[1:]):
        if low_mv <= voltage <= high_mv:
            percentage = low_pct + (high_pct - low_pct) * (voltage - low_mv) / (high_mv - low_mv)
            return round(percentage)
    return None

def decode_battery_report(battery_feature, report):
    if len(report) <= 6:
        return None, None
    if battery_feature == UNIFIED_BATTERY_FEATURE:
        percentage = report[4]
        if 0 < percentage <= 100:
            return percentage, report[6] in [1, 2, 3]
    elif battery_feature == BATTERY_VOLTAGE_FEATURE:
        voltage = report[4] << 8 | report[5]
        if voltage > 0:
            return voltage_to_percentage(voltage), bool(report[6] & 0x80)
    return None, None

def query_battery(dev, device_idx, feat_idx, battery_feature):
    function = 0x00 if battery_feature == BATTERY_VOLTAGE_FEATURE else 0x10
    try:
        flush_buffer(dev)
        cmd = [0x11, device_idx, feat_idx, function] + [0] * 16
        dev.write(cmd)
        for _ in range(20):
            r = dev.read(64, timeout_ms=50)
            if r and len(r) > 6 and r[0] == 0x11 and r[1] == device_idx and r[2] == feat_idx and r[3] == function:
                return decode_battery_report(battery_feature, r)
    except:
        pass
    return None, None

def monitor_wireless(wireless_pid, name, waybar_signal, battery_feature, state, state_lock):
    device_idx = 0x01
    dev = None

    while running:
        with state_lock:
            wired_connected = state.get('wired_connected')

        if wired_connected:
            if dev:
                try:
                    dev.close()
                except:
                    pass
                dev = None
            time.sleep(0.5)
            continue

        try:
            devs = safe_enumerate(VID, wireless_pid)

            if not devs:
                if dev:
                    try:
                        dev.close()
                    except:
                        pass
                    dev = None
                forget_receiver_kinds(wireless_pid)
                with state_lock:
                    was_connected = state.get('wireless_connected')
                    state['wireless_connected'] = False
                    wired = state.get('wired_connected')
                if was_connected and not wired:
                    write_state(name, 0, False, False, waybar_signal, state, state_lock)
                time.sleep(0.5)
                continue

            current_path = receiver_path_for_device(wireless_pid, name, devs)
            if current_path is None:
                time.sleep(0.5)
                continue

            if dev is None:
                dev = hid.device()
                dev.open_path(current_path)
                # NO set_nonblocking - we want blocking read with timeout

                time.sleep(0.1)
                enable_notifications(dev)

                # Try to query battery with retries
                feat_idx = get_feature_index(dev, device_idx, battery_feature)
                if feat_idx:
                    soc, charging = query_battery(dev, device_idx, feat_idx, battery_feature)
                    if soc is not None:
                        with state_lock:
                            state['wireless_connected'] = True
                            state['battery'] = soc
                            state['charging'] = charging
                            state['feat_idx'] = feat_idx
                            wired = state.get('wired_connected')
                        if not wired:
                            write_state(name, soc, True, charging, waybar_signal, state, state_lock)

            with state_lock:
                wired_just_disconnected = state.get('wired_just_disconnected')
                if wired_just_disconnected:
                    state['wired_just_disconnected'] = False

            if wired_just_disconnected:
                enable_notifications(dev)
                feat_idx = get_feature_index(dev, device_idx, battery_feature)
                if feat_idx:
                    soc, charging = query_battery(dev, device_idx, feat_idx, battery_feature)
                    if soc is not None:
                        with state_lock:
                            state['wireless_connected'] = True
                            state['battery'] = soc
                            state['charging'] = charging
                            state['feat_idx'] = feat_idx
                        write_state(name, soc, True, charging, waybar_signal, state, state_lock)

            # Blocking read with timeout - true event-driven
            r = dev.read(64, timeout_ms=1000)

            if r and len(r) > 4:
                # Connection event (0x41)
                if r[2] == 0x41 and r[1] == device_idx:
                    link_off = r[4] & 0x40

                    if link_off:
                        # Device disconnected/off - hide widget
                        with state_lock:
                            was_connected = state.get('wireless_connected')
                            state['wireless_connected'] = False
                            wired = state.get('wired_connected')
                        if was_connected and not wired:
                            write_state(name, 0, False, False, waybar_signal, state, state_lock)
                    else:
                        # Device woke up - query battery
                        time.sleep(0.2)
                        feat_idx = get_feature_index(dev, device_idx, battery_feature)
                        if feat_idx:
                            soc, charging = query_battery(dev, device_idx, feat_idx, battery_feature)
                            if soc is not None:
                                with state_lock:
                                    state['wireless_connected'] = True
                                    state['battery'] = soc
                                    state['charging'] = charging
                                    state['feat_idx'] = feat_idx
                                    wired = state.get('wired_connected')
                                if not wired:
                                    write_state(name, soc, True, charging, waybar_signal, state, state_lock)

                # Battery broadcast event (long HID++ 0x11)
                else:
                    with state_lock:
                        feat_idx = state.get('feat_idx')
                    if feat_idx and r[0] == 0x11 and r[1] == device_idx and r[2] == feat_idx:
                        soc, charging = decode_battery_report(battery_feature, r)
                        if soc is not None:
                            with state_lock:
                                old_battery = state.get('battery')
                                old_charging = state.get('charging')
                                state['battery'] = soc
                                state['charging'] = charging
                                state['wireless_connected'] = True
                                wired = state.get('wired_connected')
                            if (soc != old_battery or charging != old_charging) and not wired:
                                write_state(name, soc, True, charging, waybar_signal, state, state_lock)

        except Exception:
            if dev:
                try:
                    dev.close()
                except:
                    pass
                dev = None
            forget_receiver_kinds(wireless_pid)
            with state_lock:
                was_connected = state.get('wireless_connected')
                state['wireless_connected'] = False
                wired = state.get('wired_connected')
            if was_connected and not wired:
                write_state(name, 0, False, False, waybar_signal, state, state_lock)
            time.sleep(0.5)

def monitor_wired(wired_pid, name, waybar_signal, battery_feature, state, state_lock):
    device_idx = 0xff
    dev = None

    while running:
        try:
            devs = safe_enumerate(VID, wired_pid)

            if not devs:
                if dev:
                    try:
                        dev.close()
                    except:
                        pass
                    dev = None
                with state_lock:
                    was_connected = state.get('wired_connected')
                    state['wired_connected'] = False
                    state['wired_just_disconnected'] = True
                    wireless = state.get('wireless_connected')
                if was_connected and not wireless:
                    write_state(name, 0, False, False, waybar_signal, state, state_lock)
                time.sleep(0.5)
                continue

            if dev is None:
                dev = hid.device()
                dev.open_path(devs[0]['path'])
                # NO set_nonblocking - we want blocking read with timeout

                feat_idx = get_feature_index(dev, device_idx, battery_feature)
                if feat_idx:
                    soc, charging = query_battery(dev, device_idx, feat_idx, battery_feature)
                    if soc is not None:
                        with state_lock:
                            state['wired_connected'] = True
                            state['battery'] = soc
                            state['charging'] = charging
                            state['wired_feat_idx'] = feat_idx
                        write_state(name, soc, True, charging, waybar_signal, state, state_lock)

            # Blocking read with timeout - true event-driven
            with state_lock:
                wired_feat_idx = state.get('wired_feat_idx')

            if dev and wired_feat_idx:
                r = dev.read(64, timeout_ms=1000)
                # Verify: long HID++ (0x11), correct device index, correct feature index
                if r and len(r) > 6 and r[0] == 0x11 and r[1] == device_idx and r[2] == wired_feat_idx:
                    soc, charging = decode_battery_report(battery_feature, r)
                    if soc is not None:
                        with state_lock:
                            old_battery = state.get('battery')
                            old_charging = state.get('charging')
                            state['battery'] = soc
                            state['charging'] = charging
                        if soc != old_battery or charging != old_charging:
                            write_state(name, soc, True, charging, waybar_signal, state, state_lock)
            else:
                time.sleep(1)

        except Exception:
            if dev:
                try:
                    dev.close()
                except:
                    pass
                dev = None
            with state_lock:
                was_connected = state.get('wired_connected')
                state['wired_connected'] = False
                state['wired_just_disconnected'] = True
                wireless = state.get('wireless_connected')
            if was_connected and not wireless:
                write_state(name, 0, False, False, waybar_signal, state, state_lock)
            time.sleep(0.5)

def monitor_device(wireless_pid, wired_pid, name, waybar_signal):
    battery_feature = BATTERY_FEATURE_BY_RECEIVER.get(wireless_pid, UNIFIED_BATTERY_FEATURE)
    state = {
        'wireless_connected': False,
        'wired_connected': False,
        'wired_just_disconnected': False,
        'battery': None,
        'charging': None,
        'feat_idx': None,
        'wired_feat_idx': None,
        '_last_written_state': None,
    }
    state_lock = threading.Lock()

    t_wireless = threading.Thread(target=monitor_wireless, args=(wireless_pid, name, waybar_signal, battery_feature, state, state_lock), daemon=True)
    t_wired = threading.Thread(target=monitor_wired, args=(wired_pid, name, waybar_signal, battery_feature, state, state_lock), daemon=True)

    t_wireless.start()
    t_wired.start()

    return [t_wireless, t_wired]

def main():
    global running

    signal.signal(signal.SIGTERM, signal_handler)
    signal.signal(signal.SIGINT, signal_handler)
    os.makedirs(STATE_DIR, exist_ok=True, mode=0o700)

    threads = []
    for wireless_pid, wired_pid, name, waybar_signal in DEVICES:
        threads.extend(monitor_device(wireless_pid, wired_pid, name, waybar_signal))

    while running:
        time.sleep(1)

if __name__ == "__main__":
    main()
