#!/usr/bin/env python3
"""
HID++ Battery Monitor for Logitech Lightspeed and Unifying devices
- Event-driven: blocking read with timeout, no polling
"""
import hid
import sys
import time
import signal
import os
import subprocess
import threading
import tempfile
import argparse
import itertools
import hashlib
import re
import stat

VID = 0x046d
# Use XDG_RUNTIME_DIR for secure, atomic state files
STATE_DIR = os.path.join(os.environ.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}'), 'logibar')

# HID++ 1.0
RECEIVER_IDX = 0xff
REG_NOTIFICATIONS = 0x00
REG_PAIRING_INFO = 0xb5
PAIRING_INFO_DEVICE_1 = 0x20  # sub-register of device index 1; +1 per slot
FLAG_WIRELESS = 0x000100
FLAG_SOFTWARE_PRESENT = 0x000800
DEVICE_NAME_FEATURE = 0x0005
BATTERY_STATUS_FEATURE = 0x1000
BATTERY_VOLTAGE_FEATURE = 0x1001
UNIFIED_BATTERY_FEATURE = 0x1004
DEVICE_INFO_FEATURE = 0x0003

# HID++ 2.0 request byte 3 is (function << 4) | software_id, and the device
# copies it into the response. hidraw hands every input report to every open
# descriptor on the node, and a ROOT getFeature response does not say WHICH
# feature it resolves — so two concurrent lookups with the same software id
# are indistinguishable and either reader can adopt the other's index. Each
# requester therefore signs with its own id and accepts only its own echo.
# Events carry software id 0, which is why requests must never use 0.
SWID_MONITOR = 0x0d
# A feature index is the third byte of every later request to that feature.
# From 0x80 up that byte is a HID++ 1.0 register sub-id (0x80 and 0x82 are
# register WRITES), so an index the device claims there is never used: a
# hostile device must not steer a battery read into a register write.
MAX_FEATURE_INDEX = 0x80
SWID_PROBE = 0x0e
EVENT_SWID = 0x00

# Receiver identities are the only hardware list needed for discovery. Paired
# peripherals are learned from the receiver's pairing register at runtime.
# Bolt uses different pairing registers and is not in this HID++ 1.0 list.
RECEIVER_SLOTS = {
    0xc52b: 6, 0xc532: 6,  # Unifying
    0xc539: 2, 0xc545: 2, 0xc547: 2, 0xc54d: 2,  # Lightspeed
}
PAIRING_KIND = {1: 'keyboard', 2: 'mouse', 3: 'keyboard', 8: 'mouse', 13: 'headset'}
HIDPP20_KIND = {0: 'keyboard', 2: 'keyboard', 3: 'mouse', 4: 'mouse', 5: 'mouse'}
DISCOVERY_INTERVAL = 300
DISCOVERY_MANIFEST = 'receiver-devices'
LAST_KNOWN_SECONDS = 24 * 60 * 60
MODEL_RE = re.compile(r'^[A-Za-z0-9 ._()+/-]{1,48}$')
BATTERY_VOLTAGE_LEVELS = (
    (4186, 100),
    (4067, 90),
    (3989, 80),
    (3922, 70),
    (3859, 60),
    (3811, 50),
    (3778, 40),
    (3751, 30),
    (3717, 20),
    (3671, 10),
    (3646, 5),
    (3579, 2),
    (3500, 0),
)
running = True
hid_lock = threading.Lock()
publish_lock = threading.Lock()
source_states = {}
published_states = {}

def signal_handler(sig, frame):
    global running
    running = False

def cable_receivers(wpids):
    """The `rx-<id>` prefixes of the receivers that have a row for one of
    these wireless PIDs in the last scan: the receivers of the device that
    is on its cable."""
    rows = receiver_row_wpids
    return tuple(sorted({row_id.rsplit('-', 1)[0] for row_id, wpid in rows.items()
                         if wpid in wpids}))[:8]

def receiver_hash(path):
    return hashlib.blake2s(path, digest_size=4).hexdigest()

def write_state(name, battery, connected, charging, waybar_signal, state):
    """Publish a connected cable, else the lowest connected source, for a
    logical device."""
    os.makedirs(STATE_DIR, exist_ok=True, mode=0o700)
    state_file = f"{STATE_DIR}/{name}"
    wired = bool(state.get('wired_connected'))
    receivers = cable_receivers(state.get('_cable_wpids', ())) if wired else ()

    try:
        with publish_lock:
            sources = source_states.setdefault(name, {})
            # The paired name describes the device on the receiver; a cable
            # state has none, its model is the name the device gave.
            paired = state.get('_paired_model')
            model = paired or state.get('_model', '')
            sources[state['_source_id']] = (battery, connected, charging, model,
                                            wired, receivers)
            connected_sources = [source for source in sources.values() if source[1]]
            # A cable reading wins over a lower wireless one: every wireless
            # line in DEVICES sits on a receiver that discovery scans, so
            # that reading already has its own receiver row, and the cable
            # one has no other place to show.
            pool = [source for source in connected_sources if source[4]] or connected_sources
            selected = min(pool, key=lambda source: source[0]) if pool else (0, False, False, '', False, ())
            # Four lines: battery, connected, charging, model; a cable reading
            # adds "wired" as a fifth line so receiver discovery can keep a
            # real cable reading without reviving stale wireless category data.
            # The fifth line also names the receivers that have a row for the
            # cable device ("wired rx-1a2b3c4d"): the CLI hides only the
            # silent rows on those receivers, never a sleeping device elsewhere.
            # The model is the
            # one of the selected source, so a shared receiver names the device
            # whose reading is shown. Nothing connected: no model either.
            new_state = (f"{selected[0]}\n{1 if selected[1] else 0}\n"
                         f"{1 if selected[2] else 0}\n{selected[3]}"
                         + ('\nwired' + ''.join(f' {rx}' for rx in selected[5])
                            if selected[4] else ''))
            if published_states.get(name) == new_state:
                return

            # Atomic write: write to temp file, then rename
            fd, tmp_path = tempfile.mkstemp(dir=STATE_DIR)
            try:
                os.write(fd, new_state.encode())
                os.close(fd)
                os.rename(tmp_path, state_file)
            except:
                try:
                    os.close(fd)
                except:
                    pass
                try:
                    os.unlink(tmp_path)
                except:
                    pass
                raise
            published_states[name] = new_state
            # A cable change can hide or show a receiver row: scan. The
            # receiver projection comes from a scan or a receiver event and
            # has nothing new for one.
            if not state.get('_from_rows'):
                scan_requested.set()

        subprocess.run(["pkill", f"-RTMIN+{waybar_signal}", "waybar"], stderr=subprocess.DEVNULL)
    except:
        pass

# Every monitor thread polls safe_enumerate every 0.5 s while its device is
# absent, and one hid.enumerate walks every hidraw node and parses its report
# descriptor: about 20 ms of CPU on a desktop with 16 nodes. Ten threads made
# that 40% of a core. So the threads share one scan of the vendor, and the
# scan runs again only when the hidraw node set changes. The inode in the
# fingerprint catches a replug that reuses the same hidrawN name. A rescan
# also runs at least every ENUMERATE_MAX_AGE seconds, in case a change does
# not show in the fingerprint.
HIDRAW_CLASS_DIR = "/sys/class/hidraw"
ENUMERATE_MAX_AGE = 5.0
_enumeration = {"vid": None, "key": None, "at": 0.0, "devices": []}

def hidraw_fingerprint():
    """(name, inode) of every hidraw node, or None when the directory cannot
    be read: then every call scans again, as before the cache."""
    try:
        with os.scandir(HIDRAW_CLASS_DIR) as entries:
            return tuple(sorted((e.name, e.inode()) for e in entries))
    except OSError:
        return None

def safe_enumerate(vid, pid):
    """The cached HID++ nodes of exactly `pid`. Unlike hid.enumerate, a pid
    of 0 matches nothing here; vendor_nodes gives every product."""
    return [d for d in vendor_nodes(vid) if d['product_id'] == pid]

def vendor_nodes(vid):
    """The cached HID++ nodes of every product of `vid`."""
    with hid_lock:
        key = hidraw_fingerprint()
        now = time.monotonic()
        cache = _enumeration
        if (key is None or cache["vid"] != vid or cache["key"] != key
                or now - cache["at"] >= ENUMERATE_MAX_AGE):
            # Product id 0 is hidapi's "any product".
            cache["devices"] = [d for d in hid.enumerate(vid, 0) if d['usage_page'] == 0xff00]
            cache["vid"], cache["key"], cache["at"] = vid, key, now
        return list(cache["devices"])

def read_notification_flags(dev):
    """Register 0x00 of the receiver (a HID++ 1.0 short-register READ, 0x81),
    as one 24-bit number, or None when the receiver does not answer it."""
    try:
        flush_buffer(dev)
        dev.write([0x10, RECEIVER_IDX, 0x81, REG_NOTIFICATIONS, 0, 0, 0])
        for _ in range(10):
            r = dev.read(64, timeout_ms=50)
            if not r or len(r) < 7 or r[1] != RECEIVER_IDX:
                continue
            if r[0] == 0x10 and (r[2], r[3]) == (0x81, REG_NOTIFICATIONS):
                return r[4] << 16 | r[5] << 8 | r[6]
            if r[2] == 0x8f and (r[3], r[4]) == (0x81, REG_NOTIFICATIONS):
                return None
    except Exception:
        pass
    return None

NOTIFICATION_READ_ATTEMPTS = 3

def enable_notifications(dev, blind=True):
    """Turn on the receiver's wireless and software-present notifications.
    This register write is the only change logibar makes to hardware state,
    so it keeps every other flag (another program, such as Solaar, may have
    set some): read the register, OR the two bits in, and write only when a
    bit is missing. When the read gets no answer, `blind` writes the two
    bits alone, as the table monitors always did; the link listener, which
    also opens receivers logibar did not set up before, passes False and
    writes nothing rather than clear a flag it could not read. Returns
    False only when it left the register alone for that reason."""
    wanted = FLAG_WIRELESS | FLAG_SOFTWARE_PRESENT
    current = None
    for _ in range(NOTIFICATION_READ_ATTEMPTS):
        current = read_notification_flags(dev)
        if current is not None:
            break
    if current is not None and current & wanted == wanted:
        return True
    if current is None and not blind:
        return False
    flags = (current or 0) | wanted
    cmd = [0x10, RECEIVER_IDX, 0x80, REG_NOTIFICATIONS,
           (flags >> 16) & 0xff, (flags >> 8) & 0xff, flags & 0xff]
    try:
        dev.write(cmd)
        time.sleep(0.05)
        for _ in range(10):
            r = dev.read(64, timeout_ms=50)
            if not r:
                break
    except:
        pass
    return True

# Every other read loop in this file is already capped by a `range()`; this one
# was the exception. `while True` trusts the device to eventually go quiet, and
# a device that answers for ever — a wedged receiver, or anything plugged into
# the same VID/PID — spins this thread at 100% and it never returns to the
# event loop, so the widget freezes on its last reading. It cannot grow memory
# (every read is a fresh 64-byte buffer that is dropped) but it never ends.
# The cap converts "never returns" into "gives up and re-queries", which the
# retry/backoff in the callers already handles.
FLUSH_MAX_PACKETS = 64

def flush_buffer(dev):
    try:
        for _ in range(FLUSH_MAX_PACKETS):
            r = dev.read(64, timeout_ms=5)
            if not r:
                break
    except:
        pass

def pairing_reply_wpid(r, sub):
    """The wireless PID in a pairing-info reply to sub-register `sub`, or None."""
    if r[0] == 0x11 and len(r) > 8 and r[2] == 0x83 and r[3] == REG_PAIRING_INFO and r[4] == sub:
        return r[7] << 8 | r[8]
    return None

def is_pairing_error(r):
    """An error to a pairing-register read. The error report does not echo
    the sub-register, so it can also be the answer to another reader's
    request on the same node."""
    return r[0] == 0x10 and r[2] == 0x8f and r[3] == 0x83 and r[4] == REG_PAIRING_INFO


def get_feature_index(dev, device_idx, feature_id, swid=SWID_MONITOR, retries=3):
    """Get a HID++ feature index with retries. ROOT getFeature is function 0,
    so the request byte is the bare software id, and only a response echoing
    that id belongs to this caller."""
    for attempt in range(retries):
        try:
            flush_buffer(dev)
            cmd = [0x10, device_idx, 0x00, swid, feature_id >> 8, feature_id & 0xff, 0x00]
            dev.write(cmd)
            for _ in range(20):
                r = dev.read(64, timeout_ms=50)
                if r and len(r) > 4 and r[0] in [0x10, 0x11] and r[1] == device_idx and r[2] == 0x00 and r[3] == swid:
                    return r[4] if r[4] < MAX_FEATURE_INDEX else None
        except:
            pass
        if attempt < retries - 1:
            time.sleep(0.2 * (attempt + 1))  # Backoff
    return None


def voltage_to_percentage(voltage):
    if voltage >= BATTERY_VOLTAGE_LEVELS[0][0]:
        return 100
    if voltage <= BATTERY_VOLTAGE_LEVELS[-1][0]:
        return 0

    for (high_mv, high_pct), (low_mv, low_pct) in zip(BATTERY_VOLTAGE_LEVELS, BATTERY_VOLTAGE_LEVELS[1:]):
        if low_mv <= voltage <= high_mv:
            percentage = low_pct + (high_pct - low_pct) * (voltage - low_mv) / (high_mv - low_mv)
            return round(percentage)
    return None

def decode_battery_report(battery_feature, report):
    if len(report) <= 6:
        return None, None
    if battery_feature == BATTERY_STATUS_FEATURE:
        percentage, status = report[4], report[6]
        if status in (5, 6) or percentage > 100:
            return None, None
        if percentage == 0:
            # MX Master 2S reports no percentage while charging. Match
            # Solaar's approximation for these status values.
            percentage = {1: 50, 2: 50, 3: 90, 4: 20}.get(status)
        return percentage, status in (1, 2, 3, 4)
    if battery_feature == UNIFIED_BATTERY_FEATURE:
        percentage = report[4]
        if 0 < percentage <= 100:
            return percentage, report[6] in [1, 2, 3]
    elif battery_feature == BATTERY_VOLTAGE_FEATURE:
        voltage = report[4] << 8 | report[5]
        if voltage > 0:
            return voltage_to_percentage(voltage), bool(report[6] & 0x80)
    return None, None

def query_battery(dev, device_idx, feat_idx, battery_feature):
    function = 0x10 if battery_feature == UNIFIED_BATTERY_FEATURE else 0x00
    request = function | SWID_MONITOR
    try:
        flush_buffer(dev)
        cmd = [0x11, device_idx, feat_idx, request] + [0] * 16
        dev.write(cmd)
        for _ in range(20):
            r = dev.read(64, timeout_ms=50)
            if r and len(r) > 6 and r[0] == 0x11 and r[1] == device_idx and r[2] == feat_idx and r[3] == request:
                return decode_battery_report(battery_feature, r)
    except:
        pass
    return None, None

def close_quietly(dev):
    if dev:
        try:
            dev.close()
        except:
            pass
    return None


# A battery query that gets no answer is tried again after this delay, which
# doubles up to the cap. Without it, a reply lost at startup left the widget
# hidden: battery events need the feature index that only a query resolves.
REQUERY_FIRST_DELAY = 2.0
REQUERY_MAX_DELAY = 60.0

def next_requery_delay(delay):
    return min(delay * 2, REQUERY_MAX_DELAY)


# ---- Devices on a cable ----
#
# A device on its USB cable has its own hidraw node and answers HID++ 2.0 at
# device index 0xff. Like a receiver slot, it gives its own name and kind
# (0x0005), so no list of cable models is needed. Its model id (0x0003)
# carries the PIDs of its other transports, its wireless PID among them,
# which joins it to its receiver row: the "wired rx-..." line names the
# receivers that have that row, so the CLI hides the silent row of the
# device that is now on its cable.
#
# A cable node is a USB HID device (0003:046D:...) that does not sit under
# another Logitech HID device: hid-logitech-dj puts the node of each paired
# device under its receiver's node, and a Bluetooth node is 0005:.
CABLE_IDX = 0xff
CABLE_KINDS = ('keyboard', 'mouse')  # the headset file belongs to logibar-headset-monitor
CATEGORY_SIGNAL = {'keyboard': 9, 'mouse': 10}
cable_lock = threading.Lock()
cable_monitors = {}      # path -> monitor thread
cable_skipped = set()    # paths that are no cable device, until the node set changes
cable_skip_key = [None]  # the hidraw fingerprint cable_skipped belongs to
receiver_row_wpids = {}  # rx row id -> wireless PID, from the last scan
receiver_row_battery = {}  # rx row id -> (battery feature, its index), from the last scan

def sysfs_hid_device(path):
    """The resolved sysfs directory of a hidraw node's HID device."""
    name = os.path.basename(os.fsdecode(path))
    return os.path.realpath(os.path.join(HIDRAW_CLASS_DIR, name, 'device'))

def is_cable_node(hid_device_dir):
    node = os.path.basename(hid_device_dir).upper()
    parent = os.path.basename(os.path.dirname(hid_device_dir)).upper()
    return node.startswith('0003:046D:') and not parent.startswith('0003:046D:')

def cable_call(dev, feat_idx, function, swid, params=()):
    """One HID++ 2.0 request to the device on the cable; its reply or None."""
    request = function | swid
    flush_buffer(dev)
    dev.write([0x11, CABLE_IDX, feat_idx, request] + list(params) + [0] * (16 - len(params)))
    for _ in range(20):
        r = dev.read(64, timeout_ms=50)
        if (r and len(r) > 4 and r[0] == 0x11 and r[1] == CABLE_IDX
                and r[2] == feat_idx and r[3] == request):
            return r
    return None

def probe_cable(dev, pid):
    """('device', info) for a keyboard or a mouse that speaks HID++ 2.0 and
    reports a battery; ('other', None) when the node answered and is none of
    that; ('silent', None) when a request got no answer, which can pass.

    Each request signs with its own software id: a ROOT reply does not say
    which feature it resolves, so a late reply to one lookup, with a shared
    id, would give its index to the next lookup."""
    swids = itertools.cycle(DISCOVERY_SWIDS)
    name_idx = get_feature_index(dev, CABLE_IDX, DEVICE_NAME_FEATURE, swid=next(swids))
    if name_idx is None:
        return 'silent', None
    if not name_idx:
        return 'other', None
    kind_reply = cable_call(dev, name_idx, 0x20, next(swids))
    if kind_reply is None:
        return 'silent', None
    kind = HIDPP20_KIND.get(kind_reply[4])
    if kind not in CABLE_KINDS:
        return 'other', None
    length_reply = cable_call(dev, name_idx, 0x00, next(swids))
    length = min(length_reply[4], 48) if length_reply else 0
    name = bytearray()
    while len(name) < length:
        part = cable_call(dev, name_idx, 0x10, next(swids), [len(name)])
        if not part or len(part) <= 4:
            break
        name.extend(part[4:4 + min(length - len(name), len(part) - 4)])
    for battery_feature in (UNIFIED_BATTERY_FEATURE, BATTERY_STATUS_FEATURE,
                            BATTERY_VOLTAGE_FEATURE):
        feat_idx = get_feature_index(dev, CABLE_IDX, battery_feature, swid=next(swids))
        if feat_idx is None:
            return 'silent', None
        if feat_idx:
            break
    else:
        return 'other', None
    # getDeviceInfo: unit id at 5-8, transports at 9-10, then three PIDs.
    wpids = set()
    info_idx = get_feature_index(dev, CABLE_IDX, DEVICE_INFO_FEATURE, swid=next(swids))
    info = cable_call(dev, info_idx, 0x00, next(swids)) if info_idx else None
    if info and len(info) >= 17:
        wpids = {info[i] << 8 | info[i + 1] for i in (11, 13, 15)} - {0}
    return 'device', {
        'kind': kind, 'name': model_name(bytes(name).decode('utf-8', errors='replace'), kind, pid),
        'battery_feature': battery_feature, 'feat_idx': feat_idx, 'wpids': frozenset(wpids)}

CABLE_RETRY_SECONDS = 10.0
CABLE_SILENT_TRIES = 3   # then the node waits for a change of the node set
CABLE_PUBLISH_SECONDS = 1.0
cable_failures = {}      # path -> probes with no answer, in this node set
cable_retry_at = {}      # path -> monotonic time of the next probe

def monitor_cable(path, pid, generation):
    """Probe one cable node, then publish its battery from the device's own
    events. Ends when the node goes; the scan after that starts a new one.
    `generation` is the node set the probe belongs to: a probe that ends
    after a replug must not mark the new device on the same path."""
    dev = hid.device()
    state = None
    outcome = 'silent'
    try:
        dev.open_path(path)
        outcome, device = probe_cable(dev, pid)
        if device is None:
            return
        name = device['kind']
        signal = CATEGORY_SIGNAL[name]
        battery_feature, feat_idx = device['battery_feature'], device['feat_idx']
        state = {'_source_id': ('cable', path), '_model': device['name'],
                 '_cable_wpids': device['wpids'], 'wired_connected': True}
        soc = charging = None
        retry_at, delay = 0.0, REQUERY_FIRST_DELAY
        publish_at = 0.0
        while running:
            now = time.monotonic()
            if soc is None and now >= retry_at:
                soc, charging = query_battery(dev, CABLE_IDX, feat_idx, battery_feature)
                if soc is None:
                    retry_at = time.monotonic() + delay
                    delay = next_requery_delay(delay)
            if soc is not None and now >= publish_at:
                # Once a second, not only on a change: a receiver row of this
                # device can appear after it. An unchanged file is not written.
                write_state(name, soc, True, charging, signal, state)
                publish_at = now + CABLE_PUBLISH_SECONDS
            r = dev.read(64, timeout_ms=1000)
            if (r and len(r) > 6 and r[0] == 0x11 and r[1] == CABLE_IDX
                    and r[2] == feat_idx and r[3] == EVENT_SWID):
                new_soc, new_charging = decode_battery_report(battery_feature, r)
                if new_soc is not None and (new_soc, new_charging) != (soc, charging):
                    soc, charging = new_soc, new_charging
                    publish_at = 0.0
            elif not r and path not in {node['path'] for node in vendor_nodes(VID)}:
                break
    except Exception:
        pass  # unplugged: the read fails
    finally:
        close_quietly(dev)
        if state is not None:
            state['wired_connected'] = False
            write_state(name, 0, False, False, signal, state)
        rescan = False
        with cable_lock:
            if cable_monitors.get(path) is threading.current_thread():
                del cable_monitors[path]
            if cable_skip_key[0] != generation:
                rescan = True   # the node set changed during the probe
            elif outcome == 'other':
                cable_skipped.add(path)
            else:
                # No answer, or a monitor that failed on a node that may still
                # be there: try again later, never at once. An unplug changes
                # the node set, which clears this count.
                tries = cable_failures.get(path, 0) + 1
                cable_failures[path] = tries
                if tries >= CABLE_SILENT_TRIES:
                    cable_skipped.add(path)
                else:
                    wait = CABLE_RETRY_SECONDS * 2 ** (tries - 1)
                    cable_retry_at[path] = time.monotonic() + wait
                    retry = threading.Timer(wait, scan_requested.set)
                    retry.daemon = True
                    retry.start()
        if rescan and running:
            scan_requested.set()

def ensure_cable_monitors():
    """Start a monitor for each cable node that has none. A node that is no
    cable device is probed again only after the node set changes, and so is
    a node that gave no answer a few times: a probe of a node that never
    answers costs a few seconds."""
    key = hidraw_fingerprint()
    nodes = {node['path']: node['product_id'] for node in vendor_nodes(VID)
             if node['product_id'] not in RECEIVER_SLOTS}
    with cable_lock:
        if key is None or key != cable_skip_key[0]:
            cable_skipped.clear()
            cable_failures.clear()
            cable_retry_at.clear()
            cable_skip_key[0] = key
        for path, pid in sorted(nodes.items()):
            if (path in cable_monitors or path in cable_skipped
                    or cable_retry_at.get(path, 0) > time.monotonic()):
                continue
            if not is_cable_node(sysfs_hid_device(path)):
                continue
            thread = threading.Thread(target=monitor_cable, args=(path, pid, key), daemon=True)
            cable_monitors[path] = thread
            thread.start()

def receiver_codename(dev, slot):
    """Read the receiver's paired-device name, including for sleeping devices."""
    sub = 0x40 + slot - 1
    try:
        flush_buffer(dev)
        dev.write([0x10, RECEIVER_IDX, 0x83, REG_PAIRING_INFO, sub, 0, 0])
        for _ in range(12):
            r = dev.read(64, timeout_ms=50)
            if (r and len(r) > 6 and r[0] == 0x11 and r[1] == RECEIVER_IDX
                    and (r[2], r[3], r[4]) == (0x83, REG_PAIRING_INFO, sub)):
                length = min(r[5], 48)
                return bytes(r[6:6 + length]).split(b'\x00', 1)[0].decode('ascii', errors='ignore')
    except Exception:
        pass
    return ''

# Discovery talks to a receiver that a monitor thread may also have open, and
# hidraw hands every reply to every descriptor. A ROOT getFeature reply does
# not say which feature it resolves, and a getDeviceName reply does not say
# which offset it answers, so a reply that arrives after its request timed
# out matched the NEXT request with the same software id: a 0x1004 index was
# taken as the 0x1000 one, and its getCapabilities byte (0x07) was published
# as a 7 % battery. Every discovery request therefore signs with the next id
# of its own rotation — every id but the monitor (0x0d), the kind probe
# (0x0e) and events (0x00) — and accepts only its own echo. A late reply
# carries an id nobody is waiting for, and is dropped, as long as fewer than
# thirteen requests went out after it: more than one device's whole exchange
# (a five-id rotation came back to the late id on the same device).
DISCOVERY_SWIDS = (0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0a,
                   0x0b, 0x0c, 0x0f)
DISCOVERY_READS = 20     # 50 ms each: the same 1 s the monitor gives a reply
DISCOVERY_ATTEMPTS = 2   # a slow first reply after idle gets one more try
BUSY_RETRY_SECONDS = 0.1
ERR_INVALID_SUBID = 0x01  # HID++ 1.0 error: the device speaks HID++ 1.0
ERR_BUSY = 0x07           # HID++ 1.0 (0x8f): the receiver is busy
ERR20_BUSY = 0x08         # HID++ 2.0 (0xff): the device is busy
_discovery_swids = itertools.cycle(DISCOVERY_SWIDS)

def next_discovery_swid():
    """Only the scanner thread sends discovery requests, so the rotation
    needs no lock."""
    return next(_discovery_swids)

def discovery_exchange(dev, report, slot, sub_id, request):
    """Send one request; return ('reply', r), ('error', code), ('busy',
    code) or ('timeout', None). A reply echoes (slot, sub_id, request); an
    error from the receiver (0x8f) or the device (0xff) echoes (sub_id,
    request), so a request signed with its own software id can stop at its
    own error. Busy is told apart by its sender: 0x08 from the receiver is
    "unknown device" (asleep), which no retry fixes."""
    try:
        flush_buffer(dev)
        dev.write(report)
        for _ in range(DISCOVERY_READS):
            r = dev.read(64, timeout_ms=50)
            if not r or len(r) < 6 or r[0] not in (0x10, 0x11) or r[1] != slot:
                continue
            if (r[2], r[3]) == (sub_id, request):
                return 'reply', r
            if r[2] in (0x8f, 0xff) and (r[3], r[4]) == (sub_id, request):
                if (r[2], r[5]) in ((0x8f, ERR_BUSY), (0xff, ERR20_BUSY)):
                    return 'busy', r[5]
                return 'error', r[5]
    except Exception:
        pass
    return 'timeout', None

def discovery_feature_index(dev, slot, feature_id):
    """ROOT getFeature: ('reply', index) — 0 when the feature is absent —,
    ('error', code), ('busy', code) or ('timeout', None). Busy gets the same
    second try as silence."""
    outcome = ('timeout', None)
    for attempt in range(DISCOVERY_ATTEMPTS):
        if attempt and outcome[0] == 'busy':
            time.sleep(BUSY_RETRY_SECONDS)
        swid = next_discovery_swid()
        outcome = discovery_exchange(
            dev, [0x10, slot, 0x00, swid, feature_id >> 8, feature_id & 0xff, 0x00],
            slot, 0x00, swid)
        if outcome[0] == 'reply':
            index = outcome[1][4]
            return 'reply', (index if index < MAX_FEATURE_INDEX else 0)
        if outcome[0] == 'error':
            return outcome
    return outcome

def feature_request(dev, slot, index, function, payload=()):
    """The reply report, or None. A busy device gets one more try."""
    payload = list(payload)[:16]
    for attempt in range(DISCOVERY_ATTEMPTS):
        if attempt:
            time.sleep(BUSY_RETRY_SECONDS)
        request = function | next_discovery_swid()
        kind, r = discovery_exchange(
            dev, [0x11, slot, index, request] + payload + [0] * (16 - len(payload)),
            slot, index, request)
        if kind != 'busy':
            break
    return r if kind == 'reply' else None

def hidpp20_identity(dev, slot):
    """(protocol, kind, name). The protocol is 'hidpp20' when ROOT answers,
    'hidpp10' when the device rejects the HID++ 2.0 request as an unknown
    sub-id, and None when nothing answers usefully (asleep, off, out of
    range): then no battery query is worth sending."""
    outcome, value = discovery_feature_index(dev, slot, DEVICE_NAME_FEATURE)
    if outcome == 'error':
        return ('hidpp10' if value == ERR_INVALID_SUBID else None), None, ''
    if outcome != 'reply':
        return None, None, ''
    index = value
    if not index:
        return 'hidpp20', None, ''
    kind_reply = feature_request(dev, slot, index, 0x20)
    kind = HIDPP20_KIND.get(kind_reply[4], 'other') if kind_reply else None
    length_reply = feature_request(dev, slot, index, 0x00)
    name = bytearray()
    if length_reply:
        length = min(length_reply[4], 48)
        while len(name) < length:
            part = feature_request(dev, slot, index, 0x10, [len(name)])
            if not part or len(part) <= 4:
                break
            name.extend(part[4:4 + min(length - len(name), len(part) - 4)])
    return 'hidpp20', kind, bytes(name).decode('utf-8', errors='replace')

def hidpp10_battery(dev, slot):
    """Legacy 0x0d percentage or 0x07 approximate charge level. A register
    reply echoes its register, so it cannot be taken for another one."""
    for register in (0x0d, 0x07):
        for attempt in range(DISCOVERY_ATTEMPTS):
            if attempt:
                time.sleep(BUSY_RETRY_SECONDS)
            outcome, r = discovery_exchange(dev, [0x10, slot, 0x81, register, 0, 0, 0],
                                            slot, 0x81, register)
            if outcome != 'busy':
                break
        if outcome != 'reply' or len(r) < 7:
            continue
        if register == 0x0d and 0 <= r[4] <= 100:
            return r[4], (r[6] & 0xf0) == 0x50
        if register == 0x07 and r[4] in (1, 3, 5, 7):
            return {1: 5, 3: 20, 5: 50, 7: 90}[r[4]], (r[5] & 0x21) == 0x21
    return None, None

def hidpp20_battery(dev, slot):
    """(battery, charging, feature, index): the feature and its index let
    the receiver listener decode the device's own battery events."""
    for feature in (UNIFIED_BATTERY_FEATURE, BATTERY_STATUS_FEATURE,
                    BATTERY_VOLTAGE_FEATURE):
        outcome, index = discovery_feature_index(dev, slot, feature)
        if outcome != 'reply' or not index:
            continue
        # 0x1004 getStatus is function 1; 0x1000 and 0x1001 answer function 0.
        function = 0x10 if feature == UNIFIED_BATTERY_FEATURE else 0x00
        report = feature_request(dev, slot, index, function)
        if report is None:
            continue
        battery, charging = decode_battery_report(feature, report)
        if battery is not None:
            return battery, charging, feature, index
    return None, None, None, None

def generic_battery(dev, slot, protocol):
    if protocol == 'hidpp20':
        return hidpp20_battery(dev, slot)
    if protocol == 'hidpp10':
        return hidpp10_battery(dev, slot) + (None, None)
    return None, None, None, None

def pairing_exchange(dev, slot):
    """One pairing-register read: ('reply', report), ('error', code) or
    ('timeout', None). Like read_paired_info, an error does not echo the
    sub-register and may answer another reader, so it ends the read only
    once the node goes quiet, and a matching reply after it still wins."""
    sub = PAIRING_INFO_DEVICE_1 + slot - 1
    error = None
    try:
        flush_buffer(dev)
        dev.write([0x10, RECEIVER_IDX, 0x83, REG_PAIRING_INFO, sub, 0x00, 0x00])
        for _ in range(DISCOVERY_READS):
            r = dev.read(64, timeout_ms=50)
            if not r:
                if error is not None:
                    break
                continue
            if len(r) < 6 or r[1] != RECEIVER_IDX:
                continue
            if pairing_reply_wpid(r, sub) is not None:
                return 'reply', r
            if is_pairing_error(r):
                error = r[5]
    except Exception:
        pass
    return ('error', error) if error is not None else ('timeout', None)

def read_pairing_for_discovery(dev, slot):
    """The pairing report of `slot`, or None for an empty slot. The receiver
    answers its own registers whether the device is awake or not, so silence
    or a busy error is a lost exchange, not an empty slot: try again before
    dropping a paired device from the manifest for a whole scan interval."""
    for attempt in range(3):
        outcome, value = pairing_exchange(dev, slot)
        if outcome == 'reply':
            return value
        if outcome == 'error' and value != ERR_BUSY:
            return None
        if attempt < 2:
            time.sleep(0.2)
    return None

def model_name(name, kind, wpid):
    name = name.strip()
    return name if MODEL_RE.fullmatch(name) else f'Logitech {kind} {wpid:04X}'

def discover_receiver_devices():
    """Enumerate every paired slot on supported receiver families."""
    devices = []
    for pid, max_slots in RECEIVER_SLOTS.items():
        paths = {node['path'] for node in safe_enumerate(VID, pid)}
        for path in sorted(paths):
            dev = hid.device()
            try:
                dev.open_path(path)
                receiver_id = receiver_hash(path)
                for slot in range(1, max_slots + 1):
                    report = read_pairing_for_discovery(dev, slot)
                    if not report:
                        continue
                    wpid = pairing_reply_wpid(report, PAIRING_INFO_DEVICE_1 + slot - 1)
                    kind = PAIRING_KIND.get(report[11] & 0x0f, 'other') if len(report) > 11 else 'other'
                    name = receiver_codename(dev, slot)
                    protocol, feature_kind, feature_name = hidpp20_identity(dev, slot)
                    kind = feature_kind or kind
                    name = name or feature_name
                    battery, charging, feature, index = generic_battery(dev, slot, protocol)
                    devices.append({
                        'id': f'rx-{receiver_id}-{slot}', 'kind': kind,
                        'name': model_name(name, kind, wpid), 'wpid': wpid,
                        'battery': battery, 'charging': bool(charging) if battery is not None else False,
                        'battery_feature': feature, 'battery_index': index,
                    })
            except Exception as error:
                print(f'logibar-hidpp-monitor: receiver {pid:04x} scan failed: {error}',
                      file=sys.stderr)
            finally:
                close_quietly(dev)
    return devices

def atomic_state_write(path, content):
    os.makedirs(STATE_DIR, exist_ok=True, mode=0o700)
    fd, tmp_path = tempfile.mkstemp(dir=STATE_DIR)
    try:
        os.write(fd, content.encode('utf-8'))
        os.close(fd)
        os.replace(tmp_path, path)
    except Exception:
        try:
            os.close(fd)
        except OSError:
            pass
        try:
            os.unlink(tmp_path)
        except OSError:
            pass
        raise

def connecting_since(device):
    """mtime of the device's row when it carries the connecting mark, else None."""
    path = os.path.join(STATE_DIR, device['id'])
    raw = read_small_file(path, 512)
    if raw is None or raw.decode('utf-8', errors='replace').splitlines()[6:7] != [CONNECTING_MARK]:
        return None
    try:
        return os.stat(path, follow_symlinks=False).st_mtime
    except OSError:
        return None

def previous_receiver_reading(device, now):
    """Keep a recent successful reading for the same pairing, never its charge flag."""
    path = os.path.join(STATE_DIR, device['id'])
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW)
        try:
            info = os.fstat(fd)
            if not stat.S_ISREG(info.st_mode) or info.st_size > 512:
                return None
            lines = os.read(fd, 512).decode('utf-8', errors='replace').splitlines()
        finally:
            os.close(fd)
    except OSError:
        return None
    if len(lines) < 4 or lines[3] != device['name']:
        return None
    if len(lines) >= 6 and lines[5] != f"{device['wpid']:04x}":
        return None
    try:
        battery = int(lines[0])
        seen = int(lines[4]) if len(lines) >= 5 else int(info.st_mtime)
    except ValueError:
        return None
    if not 0 <= battery <= 100 or not 0 < seen <= now:
        return None
    if len(lines) < 5 and lines[1] != '1':
        return None
    if now - seen > LAST_KNOWN_SECONDS:
        return None
    return battery, seen

def publish_discovered(devices, started=None):
    """`started`: when the scan began (time.time()). A connecting mark the
    link listener wrote after that is newer than this scan's view of the
    device, so a scan that found no answer keeps it instead of erasing it."""
    global receiver_row_wpids, receiver_row_battery
    now = int(time.time())
    for device in devices:
        with rows_lock:
            publish_receiver_row(device, started, now)
    receiver_row_wpids = {device['id']: device['wpid'] for device in devices}
    receiver_row_battery = {device['id']: (device['battery_feature'], device['battery_index'])
                            for device in devices if device.get('battery_index')}
    lines = ['logibar-receivers-v1']
    lines.extend(f"{device['id']}\t{device['kind']}" for device in devices)
    atomic_state_write(os.path.join(STATE_DIR, DISCOVERY_MANIFEST), '\n'.join(lines) + '\n')
    publish_categories()

def publish_receiver_row(device, started, now):
    """Write one receiver row; the caller holds rows_lock. A link-down newer
    than the scan wins over the answer the scan heard before it."""
    battery = device['battery']
    if (battery is not None and started is not None
            and link_down_at.get(device['id'], 0) >= started):
        battery = None
    previous = previous_receiver_reading(device, now) if battery is None else None
    stored_battery = battery if battery is not None else (previous[0] if previous else 0)
    last_seen = now if battery is not None else (previous[1] if previous else 0)
    content = (f"{stored_battery}\n{1 if battery is not None else 0}\n"
               f"{1 if battery is not None and device['charging'] else 0}\n"
               f"{device['name']}\n{last_seen}\n{device['wpid']:04x}")
    if battery is None and started is not None:
        marked = connecting_since(device)
        if marked is not None and marked >= started:
            content += f"\n{CONNECTING_MARK}"
    atomic_state_write(os.path.join(STATE_DIR, device['id']), content)

def scan_receivers():
    started = time.time()
    devices = discover_receiver_devices()
    publish_discovered(devices, started)
    return devices

# A rescan runs every DISCOVERY_INTERVAL seconds, and sooner when asked:
# SIGUSR1 (sent by `logibar-hidpp-monitor --refresh`, the panel's click) or a
# monitor thread publishing a change, so the receiver rows follow the same
# wake, sleep and battery events the category files do. A short settle delay
# lets the monitor finish its own exchange first and folds a burst of events
# into one scan.
scan_requested = threading.Event()
RESCAN_SETTLE_SECONDS = 1.0
PID_FILE = 'hidpp-monitor.pid'
# `--refresh` returns on the next manifest write, which may end a scan that
# was already running, so the wait covers one whole worst-case scan: two
# full Unifying receivers of sleeping devices took about 24 s on the fake
# bus. The panel's `timeout` sits 5 s above this.
REFRESH_WAIT_SECONDS = 45.0

def request_scan(*_):
    scan_requested.set()

def receiver_scan_loop():
    while running:
        scan_requested.clear()
        try:
            scan_receivers()
            ensure_listeners()
            ensure_cable_monitors()
        except Exception as error:
            print(f'logibar-hidpp-monitor: discovery failed: {error}', file=sys.stderr)
        deadline = time.monotonic() + DISCOVERY_INTERVAL
        while running and time.monotonic() < deadline:
            if scan_requested.wait(1):
                time.sleep(RESCAN_SETTLE_SECONDS)
                break

# ---- Receiver connection events ----
#
# The scan polls. A receiver also announces each link change itself: HID++
# 1.0 notification 0x41, byte 4 bit 0x40 set when the device has no link
# (off, asleep or out of range). One listener per receiver node turns that
# into the rows at once, like G HUB: link up adds the connecting mark to the
# device's row and asks for a scan, which brings the reading a second or two
# later; link down publishes the row as not answering. A listener blocks in
# read() and wakes only for a report or once per second to see `running`:
# it never queries the devices. A watcher thread looks at the hidraw node
# set every few seconds (a directory listing, not a device query) and asks
# for a scan when a receiver comes or goes; the scan starts the listeners.
CONNECTING_MARK = 'connecting'
LINK_OFF = 0x40
LISTEN_TIMEOUT_MS = 1000
HOTPLUG_CHECK_SECONDS = 2.0
LISTENER_RETRY_SECONDS = 10.0
listener_retry_at = {}   # path -> time.monotonic() before which no listener restarts
listeners = {}
listeners_lock = threading.Lock()
# row id -> time.time() of its last link-down event. A scan that started
# before it may still have heard the device answer; that answer is older
# than the link-down and must not bring the row back (seen live: the M720
# switched off, reappeared for 1.4 s, then went).
link_down_at = {}
# Serializes the two writers of a receiver row (the listener and the scan),
# so a link event cannot land between the scan's check and its write.
rows_lock = threading.Lock()
# Receiver paths already logged as not answering the register read.
unanswered_receivers = set()

def on_link_change(row_id, link_off):
    """Rewrite the device's row for a link change and ask for a scan. Only a
    row the scan already published is touched: a slot without one (a device
    paired after the last scan) appears with that scan."""
    path = os.path.join(STATE_DIR, row_id)
    with rows_lock:
        if link_off:
            link_down_at[row_id] = time.time()
        raw = read_small_file(path, 512)
        lines = raw.decode('utf-8', errors='replace').splitlines()[:6] if raw else []
        if len(lines) == 6:
            if link_off:
                lines[1], lines[2] = '0', '0'
            elif lines[1] != '1':
                lines.append(CONNECTING_MARK)
            try:
                atomic_state_write(path, '\n'.join(lines))
            except OSError:
                pass
    scan_requested.set()
    publish_categories()

def on_battery_event(row_id, report):
    """A battery event of a device that the last scan found: rewrite its
    row at once, like the scan would. An event from a slot or a feature
    index the scan does not know is not a battery reading."""
    feature, index = receiver_row_battery.get(row_id, (None, None))
    if not index or report[2] != index:
        return
    battery, charging = decode_battery_report(feature, report)
    if battery is None:
        return
    path = os.path.join(STATE_DIR, row_id)
    with rows_lock:
        raw = read_small_file(path, 512)
        lines = raw.decode('utf-8', errors='replace').splitlines()[:6] if raw else []
        if len(lines) != 6:
            return
        lines[0:3] = [str(battery), '1', '1' if charging else '0']
        lines[4] = str(int(time.time()))
        try:
            atomic_state_write(path, '\n'.join(lines))
        except OSError:
            return
    publish_categories()

# The single-device widgets (logibar-mouse, logibar-keyboard) read one file
# per kind. It is a projection of the receiver rows: the connected device of
# that kind with the lowest battery, with its own name, the same device the
# combined widget and the Omarchy panel show. A cable reading still wins in
# write_state.
categories_lock = threading.Lock()

def publish_categories():
    raw = read_small_file(os.path.join(STATE_DIR, DISCOVERY_MANIFEST), 4096)
    rows = []
    for line in (raw.decode('utf-8', errors='replace').splitlines()[1:] if raw else []):
        row_id, _, kind = line.partition('\t')
        if kind not in CABLE_KINDS:
            continue
        content = read_small_file(os.path.join(STATE_DIR, row_id), 512)
        fields = content.decode('utf-8', errors='replace').splitlines() if content else []
        if len(fields) < 4 or fields[1] != '1' or not fields[0].isdigit():
            continue
        rows.append((kind, min(int(fields[0]), 100), fields[2] == '1', fields[3]))
    with categories_lock:
        for kind in CABLE_KINDS:
            state = {'_source_id': ('rx', kind), '_from_rows': True}
            mine = [row for row in rows if row[0] == kind]
            if mine:
                _, battery, charging, name = min(mine, key=lambda row: row[1])
                state['_model'] = name if MODEL_RE.fullmatch(name) else ''
                write_state(kind, battery, True, charging, CATEGORY_SIGNAL[kind], state)
            else:
                write_state(kind, 0, False, False, CATEGORY_SIGNAL[kind], state)

def listen_receiver(path, max_slots):
    rx = receiver_hash(path)
    dev = hid.device()
    try:
        dev.open_path(path)
        if not enable_notifications(dev, blind=False):
            # Without its link events the listener is no use. Give its place
            # back to the periodic scan (not the short retry: a receiver that
            # never answers would scan every few seconds), and log it once.
            if path not in unanswered_receivers:
                unanswered_receivers.add(path)
                print(f'logibar-hidpp-monitor: receiver {path!r} did not answer the notification '
                      'register read; its devices appear with the next scan', file=sys.stderr)
            with listeners_lock:
                listener_retry_at[path] = time.monotonic() + DISCOVERY_INTERVAL
            return
        unanswered_receivers.discard(path)
        # The register exchange above reads and drops whatever arrives, a
        # link event included: one scan covers that window.
        scan_requested.set()
        while running:
            r = dev.read(64, timeout_ms=LISTEN_TIMEOUT_MS)
            if not r or len(r) <= 4 or not 1 <= r[1] <= max_slots:
                continue
            if r[0] == 0x10 and r[2] == 0x41:
                on_link_change(f'rx-{rx}-{r[1]}', bool(r[4] & LINK_OFF))
            elif r[0] == 0x11 and r[3] == EVENT_SWID and len(r) > 6:
                # A HID++ 2.0 event: a battery reading when it comes from
                # the battery feature index the scan found for that slot.
                on_battery_event(f'rx-{rx}-{r[1]}', r)
            elif r[0] == 0x10 and r[2] in (0x07, 0x0d):
                # A HID++ 1.0 device reports its battery register: no index
                # to decode against, so the scan reads it.
                scan_requested.set()
    except Exception:
        # Unplugged (read raises) or a transient error: a scan in a few
        # seconds starts a new listener if the receiver is still there,
        # without a scan loop while it keeps failing.
        if running:
            with listeners_lock:
                listener_retry_at[path] = time.monotonic() + LISTENER_RETRY_SECONDS
            retry = threading.Timer(LISTENER_RETRY_SECONDS, scan_requested.set)
            retry.daemon = True
            retry.start()
    finally:
        close_quietly(dev)
        with listeners_lock:
            listeners.pop(path, None)

def ensure_listeners():
    for pid, max_slots in RECEIVER_SLOTS.items():
        for node in safe_enumerate(VID, pid):
            path = node['path']
            with listeners_lock:
                if path in listeners or listener_retry_at.get(path, 0) > time.monotonic():
                    continue
                thread = threading.Thread(target=listen_receiver, args=(path, max_slots),
                                          daemon=True)
                listeners[path] = thread
            thread.start()

def watch_hotplug():
    seen = hidraw_fingerprint()
    while running:
        time.sleep(HOTPLUG_CHECK_SECONDS)
        current = hidraw_fingerprint()
        if current != seen:
            seen = current
            scan_requested.set()

def read_small_file(path, limit):
    """Bounded read of a regular file this user owns, or None. No symlink,
    no FIFO: the open does not follow or block, and the type is checked on
    the open descriptor."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW)
    except OSError:
        return None
    try:
        info = os.fstat(fd)
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid()
                or info.st_size > limit):
            return None
        return os.read(fd, limit + 1)[:limit + 1]
    except OSError:
        return None
    finally:
        os.close(fd)

def process_start_time(pid):
    """Field 22 of /proc/<pid>/stat (clock ticks after boot), or None. With
    the pid it names one process: a reused pid has another start time."""
    try:
        with open(f'/proc/{pid}/stat', 'rb') as stat_file:
            line = stat_file.read(4096)
    except OSError:
        return None
    # The command name (field 2) may hold spaces and parentheses.
    fields = line[line.rfind(b')') + 2:].split()
    return fields[19].decode() if len(fields) > 19 and fields[19].isdigit() else None

def is_monitor_argv(argv):
    """`logibar-hidpp-monitor ...` or `python3 .../logibar-hidpp-monitor ...`
    — not any program that has the file as an argument (an editor)."""
    if not argv:
        return False
    if os.path.basename(argv[0]) == b'logibar-hidpp-monitor':
        return True
    if re.fullmatch(rb'python[0-9.]*', os.path.basename(argv[0])) is None:
        return False
    # Interpreter options (`python3 -I -u script`) come before the script.
    script = next((arg for arg in argv[1:8] if not arg.startswith(b'-')), b'')
    return os.path.basename(script) == b'logibar-hidpp-monitor'

def running_daemon_pid():
    """The pid in the daemon's pid file, if that process is still this
    user's logibar-hidpp-monitor daemon; None otherwise. The file holds the
    pid and its start time, so a pid the kernel gave to another process
    never matches."""
    raw = read_small_file(os.path.join(STATE_DIR, PID_FILE), 40)
    match = re.fullmatch(rb'([0-9]{1,10}) ([0-9]{1,20})\n?', raw or b'')
    if not match:
        return None
    pid = int(match[1])
    if pid <= 1 or pid == os.getpid():
        return None
    try:
        if os.stat(f'/proc/{pid}').st_uid != os.getuid():
            return None
        with open(f'/proc/{pid}/cmdline', 'rb') as cmdline:
            argv = cmdline.read(4096).split(b'\0')
    except OSError:
        return None
    if process_start_time(pid) != match[2].decode():
        return None
    if b'--refresh' in argv or not is_monitor_argv(argv):
        return None
    return pid

def manifest_stamp():
    try:
        info = os.stat(os.path.join(STATE_DIR, DISCOVERY_MANIFEST), follow_symlinks=False)
        return info.st_ino, info.st_mtime_ns
    except OSError:
        return None

def refresh_via_daemon(wait=REFRESH_WAIT_SECONDS):
    """Ask the running daemon for a rescan and wait, bounded, until it has
    published a new manifest. The click path never touches the hardware
    itself: a second scanner on the same receivers is exactly the cross-talk
    the software ids exist to prevent, and a second writer of the category
    files would leave the daemon's published cache describing a file that
    is no longer on disk."""
    pid = running_daemon_pid()
    if pid is None:
        print('logibar-hidpp-monitor: no running daemon to refresh', file=sys.stderr)
        return 1
    before = manifest_stamp()
    try:
        # The pidfd pins the process: checked again while it is held, the
        # pid cannot pass to another process between the check and the
        # signal.
        pidfd = os.pidfd_open(pid)
        try:
            if running_daemon_pid() != pid:
                raise ProcessLookupError(f'pid {pid} is no longer the daemon')
            signal.pidfd_send_signal(pidfd, signal.SIGUSR1)
        finally:
            os.close(pidfd)
    except OSError as error:
        print(f'logibar-hidpp-monitor: refresh failed: {error}', file=sys.stderr)
        return 1
    deadline = time.monotonic() + wait
    while time.monotonic() < deadline:
        if manifest_stamp() != before:
            return 0
        time.sleep(0.2)
    print('logibar-hidpp-monitor: the daemon did not rescan in time', file=sys.stderr)
    return 1

def main():
    global running

    parser = argparse.ArgumentParser()
    parser.add_argument('--refresh', action='store_true',
                        help='ask the running daemon to rescan the receivers, then exit')
    args = parser.parse_args()
    if args.refresh:
        return refresh_via_daemon()

    signal.signal(signal.SIGTERM, signal_handler)
    signal.signal(signal.SIGINT, signal_handler)
    # Installed before the pid file exists: SIGUSR1's default action ends the
    # process, so a refresh must never find a pid that cannot handle it.
    signal.signal(signal.SIGUSR1, request_scan)
    os.makedirs(STATE_DIR, exist_ok=True, mode=0o700)
    pid_file = os.path.join(STATE_DIR, PID_FILE)
    pid_line = f'{os.getpid()} {process_start_time(os.getpid())}\n'
    atomic_state_write(pid_file, pid_line)

    threading.Thread(target=receiver_scan_loop, daemon=True).start()
    threading.Thread(target=watch_hotplug, daemon=True).start()

    while running:
        time.sleep(1)
    try:
        if read_small_file(pid_file, 40) == pid_line.encode():
            os.unlink(pid_file)
    except OSError:
        pass
    return 0

if __name__ == "__main__":
    sys.exit(main())
