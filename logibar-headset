#!/bin/bash
# Logitech PRO X 2 LIGHTSPEED Battery Widget for Waybar
#
# Usage: logibar-headset [--color-normal HEX] [--color-warning HEX] [--color-critical HEX]
#        [--no-color[=all|bar|tooltip]]
#
# --no-color drops color markup from the bar text, the tooltip, or both
# (`all` when the value is omitted); NO_COLOR in the environment means =all,
# and an explicit flag wins over it. The waybar `class` field is unaffected,
# so CSS styling keeps working.

STATE_FILE="${XDG_RUNTIME_DIR:-/run/user/$UID}/logibar/headset"
ICON="󰋎"
ICON_CHARGING="󰋎 ⚡"
TOOLTIP="PRO X 2 Headset"

# Structured argument errors, escaped by jq so a hostile or multi-line value
# cannot break out of the JSON (jq is a hard dependency of the output path).
cli_error() {  # cli_error MESSAGE
    if command -v jq >/dev/null 2>&1; then
        jq -nc --arg m "$1" '{text:"\u26a0", tooltip:$m, class:"critical"}'
    else
        echo '{"text":"\u26a0","tooltip":"invalid arguments","class":"critical"}'
    fi
    exit 0
}

# Same hex forms logibar-status accepts. Overrides are interpolated into
# single-quoted Pango attributes, so anything else is refused at the door.
_is_hex() { [[ "$1" =~ ^#([0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$ ]]; }

# --- Parse args ---
CLI_COLOR_NORMAL=""
CLI_COLOR_WARNING=""
CLI_COLOR_CRITICAL=""
FRAME=false
FRAME_FONT="JetBrainsMono Nerd Font Mono"
PLAIN_SURFACES=""   # "" | all | bar | tooltip
_nc=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --color-normal)   [[ $# -ge 2 ]] || cli_error "--color-normal requires a value"
                          _is_hex "$2" || cli_error "--color-normal expects a hex color like #98c379, got: $2"
                          CLI_COLOR_NORMAL="$2"; shift 2 ;;
        --color-warning)  [[ $# -ge 2 ]] || cli_error "--color-warning requires a value"
                          _is_hex "$2" || cli_error "--color-warning expects a hex color like #e5c07b, got: $2"
                          CLI_COLOR_WARNING="$2"; shift 2 ;;
        --color-critical) [[ $# -ge 2 ]] || cli_error "--color-critical requires a value"
                          _is_hex "$2" || cli_error "--color-critical expects a hex color like #e06c75, got: $2"
                          CLI_COLOR_CRITICAL="$2"; shift 2 ;;
        --no-color) PLAIN_SURFACES="all"; shift ;;
        --no-color=*)
            _nc="${1#*=}"
            case "$_nc" in
                all|bar|tooltip) PLAIN_SURFACES="$_nc" ;;
                *) cli_error "unknown --no-color value: $_nc (expected all, bar or tooltip)" ;;
            esac
            shift ;;
        --frame) FRAME=true; shift ;;
        --frame-font) [[ $# -ge 2 ]] || cli_error "--frame-font requires a value"
                      FRAME_FONT="$2"; shift 2 ;;
        *) cli_error "Unknown option: $1" ;;
    esac
done

# https://no-color.org - any non-empty NO_COLOR means monochrome everywhere,
# but an explicit --no-color=... is the more specific instruction and wins.
[[ -z "$PLAIN_SURFACES" && -n "${NO_COLOR:-}" ]] && PLAIN_SURFACES="all"
BAR_PLAIN=false
TIP_PLAIN=false
case "$PLAIN_SURFACES" in
    all)     BAR_PLAIN=true; TIP_PLAIN=true ;;
    bar)     BAR_PLAIN=true ;;
    tooltip) TIP_PLAIN=true ;;
esac

# --- Colors: CLI overrides > Omarchy theme > One Dark defaults ---
COLOR_NORMAL="#98c379"
COLOR_WARNING="#e5c07b"
COLOR_CRITICAL="#e06c75"
ACCENT="#61afef"
FG="#abb2bf"
BG="#282c34"

hex_blend() {  # average two #RRGGBB colors
    local c1="${1#\#}" c2="${2#\#}"
    printf '#%02x%02x%02x' \
        $(( (16#${c1:0:2} + 16#${c2:0:2}) / 2 )) \
        $(( (16#${c1:2:2} + 16#${c2:2:2}) / 2 )) \
        $(( (16#${c1:4:2} + 16#${c2:4:2}) / 2 ))
}

# Color resolution — flags > Omarchy theme (XDG state dir, then legacy config)
# > pywal cache > One Dark — lives in logibar-status, so these compatibility
# widgets cannot drift from the combined module. logibar-status ships in the
# same install target, so it sits next to this script; fall back to PATH, and
# to the One Dark defaults above if it is missing entirely.
_resolved=false
_status="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/logibar-status"
[[ -x "$_status" ]] || _status="$(command -v logibar-status 2>/dev/null)"
if [[ -n "$_status" && -x "$_status" ]] && command -v jq >/dev/null 2>&1; then
    # One value per line, never tab-separated: tab is IFS whitespace, so `read`
    # would collapse empty fields and shift every later color one slot left.
    _pal=()
    mapfile -t _pal < <("$_status" --json \
        ${CLI_COLOR_CRITICAL:+--color-critical "$CLI_COLOR_CRITICAL"} \
        ${CLI_COLOR_WARNING:+--color-warning "$CLI_COLOR_WARNING"} \
        ${CLI_COLOR_NORMAL:+--color-normal "$CLI_COLOR_NORMAL"} 2>/dev/null \
        | jq -r '.palette | (.critical // ""), (.warning // ""), (.ok // ""),
                            (.accent // ""), (.foreground // ""), (.background // "")' 2>/dev/null)
    if [[ ${#_pal[@]} -eq 6 && -n "${_pal[0]}" ]]; then
        COLOR_CRITICAL="${_pal[0]}"
        COLOR_WARNING="${_pal[1]}"
        COLOR_NORMAL="${_pal[2]}"
        [[ -n "${_pal[3]}" ]] && ACCENT="${_pal[3]}"
        [[ -n "${_pal[4]}" ]] && FG="${_pal[4]}"
        [[ -n "${_pal[5]}" ]] && BG="${_pal[5]}"
        _resolved=true   # overrides were applied by logibar-status, normalized
    fi
fi

if ! $_resolved; then
    # No logibar-status: One Dark, plus any override that Pango can render
    # literally (it understands #rgb and #rrggbb, but not an alpha suffix).
    [[ "$CLI_COLOR_NORMAL"   =~ ^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$ ]] && COLOR_NORMAL="$CLI_COLOR_NORMAL"
    [[ "$CLI_COLOR_WARNING"  =~ ^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$ ]] && COLOR_WARNING="$CLI_COLOR_WARNING"
    [[ "$CLI_COLOR_CRITICAL" =~ ^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$ ]] && COLOR_CRITICAL="$CLI_COLOR_CRITICAL"
fi

DIM=$(hex_blend "$FG" "$BG")
BAR_EMPTY=$(hex_blend "$BG" "$DIM")

# --- Read state ---
if [[ ! -f "$STATE_FILE" ]]; then
    echo '{"text": ""}'
    exit 0
fi

BATTERY=$(sed -n '1p' "$STATE_FILE")
CONNECTED=$(sed -n '2p' "$STATE_FILE")
CHARGING=$(sed -n '3p' "$STATE_FILE")

if [[ -z "$BATTERY" ]] || [[ "$BATTERY" == "0" ]] || [[ "$CONNECTED" != "1" ]]; then
    echo '{"text": ""}'
    exit 0
fi

# --- Severity → class + bar color (bar color is always set, for the gauge) ---
if [[ $BATTERY -le 10 ]]; then
    CLASS="critical"; COLOR="$COLOR_CRITICAL"; BAR_COLOR="$COLOR_CRITICAL"
elif [[ $BATTERY -le 20 ]]; then
    CLASS="warning"; COLOR="$COLOR_WARNING"; BAR_COLOR="$COLOR_WARNING"
else
    CLASS="normal"; COLOR=""; BAR_COLOR="$COLOR_NORMAL"
fi

# --- Bar text (the waybar module label) ---
if [[ "$CHARGING" == "1" ]]; then DISPLAY_ICON="$ICON_CHARGING"; else DISPLAY_ICON="$ICON"; fi
if [[ -n "$COLOR" ]] && ! $BAR_PLAIN; then
    BATTERY_TEXT="<span size='small' foreground='${COLOR}'>$BATTERY%</span>"
else
    BATTERY_TEXT="<span size='small'>$BATTERY%</span>"
fi

# --- Tooltip: framed battery card (family style) ---
strip_tags() { sed 's/<[^>]*>//g' <<< "$1"; }

# Tooltip markup helpers: on a plain surface they emit no color markup, while
# keeping weight, glyphs, gauge characters and layout. Widths still line up
# because _pad()/_cpad() measure stripped text.
tip_c() {   # tip_c COLOR TEXT
    if $TIP_PLAIN; then printf '%s' "$2"
    else printf "<span foreground='%s'>%s</span>" "$1" "$2"; fi
}

tip_bc() {  # tip_bc COLOR TEXT - bold, colored unless the tooltip is plain
    if $TIP_PLAIN; then printf "<span font_weight='bold'>%s</span>" "$2"
    else printf "<span font_weight='bold' foreground='%s'>%s</span>" "$1" "$2"; fi
}
BAR_LEN=14
filled=$(( BATTERY * BAR_LEN / 100 ))
(( filled > BAR_LEN )) && filled=$BAR_LEN
(( filled < 0 )) && filled=0
printf -v _bf '%*s' "$filled" ''
printf -v _be '%*s' "$(( BAR_LEN - filled ))" ''
gauge="$(tip_c "$BAR_COLOR" "${_bf// /█}")$(tip_c "$BAR_EMPTY" "${_be// /░}")"

if [[ "$CHARGING" == "1" ]]; then
    status=$(tip_c "$COLOR_NORMAL" "$(printf '\U000F0084')  Charging")
else
    status=$(tip_c "$DIM" "$(printf '\U000F007E')  On battery")
fi

title=$(tip_bc "$ACCENT" "${ICON}  ${TOOLTIP}")
row_bar="   ${gauge}  $(tip_bc "$BAR_COLOR" "${BATTERY}%")"
row_status="   ${status}"

INNER=0
for _ln in "$title" "$row_bar" "$row_status"; do
    _p=$(strip_tags "$_ln"); (( ${#_p} > INNER )) && INNER=${#_p}
done
INNER=$(( INNER + 1 ))
_pad()  { local _p; _p=$(strip_tags "$1"); local n=$(( INNER - ${#_p} )); (( n < 0 )) && n=0; local s; printf -v s '%*s' "$n" ''; printf '%s%s' "$1" "$s"; }
_cpad() { local _p; _p=$(strip_tags "$1"); local n=$(( INNER - ${#_p} )); (( n < 0 )) && n=0; local l=$(( n/2 )) r=$(( n - n/2 )) ls rs; printf -v ls '%*s' "$l" ''; printf -v rs '%*s' "$r" ''; printf '%s%s%s' "$ls" "$1" "$rs"; }

B="<span foreground='${ACCENT}'>"; E="</span>"; NL=$'\n'
if $TIP_PLAIN; then B=""; E=""; fi
printf -v _border '%*s' "$INNER" ''; _border="${_border// /─}"
printf -v _sepd '%*s' "$(( INNER - 2 ))" ''; _sepd="${_sepd// /─}"
if [[ "$FRAME" == "true" ]]; then
    # Framed: box pinned to a Mono Nerd Font so text/box-drawing/icons share one
    # uniform advance — alignment holds regardless of the user's bar font.
    TIP="${B}╭${_border}╮${E}${NL}"
    TIP+="${B}│${E}$(_cpad "$title")${B}│${E}${NL}"
    TIP+="${B}│${E}$(_pad " $(tip_c "$DIM" "$_sepd")")${B}│${E}${NL}"
    TIP+="${B}│${E}$(_pad "$row_bar")${B}│${E}${NL}"
    TIP+="${B}│${E}$(_pad "$row_status")${B}│${E}${NL}"
    TIP+="${B}╰${_border}╯${E}"
    _ff=$(sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g; s/'\''/\&apos;/g' <<< "$FRAME_FONT")
    TIP="<span font_family='${_ff}'>${TIP}</span>"
else
    # Plain (default): no border, no font pin → renders in the user's font.
    # Leading space aligns the title with the rule below it.
    TIP=" ${title}${NL}"
    TIP+=" $(tip_c "$DIM" "$_sepd")${NL}"
    TIP+="${row_bar}${NL}"
    TIP+="${row_status}"
fi

jq -nc --arg t "$DISPLAY_ICON ${BATTERY_TEXT}" --arg tip "$TIP" --arg class "$CLASS" --argjson pct "$BATTERY" \
    '{text:$t, tooltip:$tip, class:$class, percentage:$pct}'
